# Token del bot Telegram (da @BotFather). Senza token il server parte lo
# stesso ma senza bot: si gioca solo in modalità demo dal browser.
BOT_TOKEN=

# URL https pubblico della webapp (obbligatorio per i pulsanti web_app:
# Telegram rifiuta http, anche per localhost). In sviluppo: tunnel verso la
# porta locale, es. `cloudflared tunnel --url http://localhost:8765`.
WEBAPP_URL=

# Porta del server (default 8765 — la 8000 è spesso occupata da altri progetti)
PORT=8765

# Origini ammesse per /api/match (CORS). "*" = aperto (default); per
# restringere: "https://durak.vercel.app,https://altro.dominio"
CORS_ORIGINS=*
